# Copy this to .env and adjust for your setup.

SENTINELAI_NODE_ID=hub
SENTINELAI_MQTT_HOST=localhost
SENTINELAI_MQTT_PORT=1883
SENTINELAI_DB_PATH=./database/sentinelai.db
SENTINELAI_CONFIDENCE_THRESHOLD=0.5
SENTINELAI_DASHBOARD_USER=admin
SENTINELAI_DASHBOARD_PASSWORD=change-me
SENTINELAI_RFID_AUTH_WINDOW_SECONDS=30
