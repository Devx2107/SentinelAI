+        FROM events WHERE julianday(timestamp) >= julianday(?) AND julianday(timestamp) < julianday(?)''', (iso(now - timedelta(hours=24)), iso(now)))[0])
+    return {'hub': {'node_id': providers.node_id, 'uptime_seconds': providers.uptime()},
