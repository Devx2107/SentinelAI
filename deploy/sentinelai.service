[Unit]
Description=SentinelAI hub and dashboard
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=sentinelai
WorkingDirectory=/opt/sentinelai
ExecStart=/opt/sentinelai/.venv/bin/python hub/run.py --mode live
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
