# Copy to the repo root as .env. Values are literal, not shell expressions.
SENTINELAI_NODE_ID=hub
SENTINELAI_DASHBOARD_USER=admin
SENTINELAI_DASHBOARD_PASSWORD=change-me
SENTINELAI_MQTT_HOST=localhost
SENTINELAI_MQTT_PORT=1883
SENTINELAI_HTTP_HOST=0.0.0.0
SENTINELAI_HTTP_PORT=5000
SENTINELAI_STALE_AFTER_SECONDS=90
SENTINELAI_MODEL_PATH=/opt/sentinelai/models/mobilenet_ssd_v2_coco_quant.tflite
SENTINELAI_LABELS_PATH=/opt/sentinelai/models/coco_labels.txt
# Built-in RC522 adapter. Comment out to run without a physical RFID reader.
SENTINELAI_RFID_READER_FACTORY=modules.rfid_auth.rc522:create_reader
SENTINELAI_RFID_SPI_PORT=0
SENTINELAI_RFID_SPI_DEVICE=0
SENTINELAI_RFID_RESET_PIN=25
# Default runtime DB is <repo>/data/sentinelai.db (never the committed sample).
